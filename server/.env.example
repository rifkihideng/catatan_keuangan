# ===== Server =====
PORT=3001

# ===== Database (Turso) =====
# URL database Turso (format libsql://... atau https://...). Wajib diisi.
TURSO_DATABASE_URL=
# Token autentikasi untuk mengakses database Turso. Wajib diisi.
TURSO_AUTH_TOKEN=

# ===== Autentikasi =====
ALLOW_SIGNUP=1
TRUST_PROXY=
SESSION_HOURS=720
SESSION_SHORT_HOURS=12
MIN_PASSWORD_LENGTH=

# ===== URL =====
# Alamat server/API (redirect_uri OAuth & cadangan alamat frontend)
PUBLIC_URL=http://localhost:3001
# Alamat frontend bila client & server di host berbeda
APP_URL=

# ===== Email (Resend, opsional) =====
# EMAIL_FROM pakai pengirim bawaan Resend untuk tes: Catatan Keuangan <onboarding@resend.dev>
# (hanya terkirim ke email akun Resend). Untuk produksi gunakan domain yang sudah diverifikasi.
RESEND_API_KEY=
EMAIL_FROM=
APP_NAME=

# ===== Token =====
RESET_TOKEN_MINUTES=60
VERIFY_TOKEN_HOURS=24
REQUIRE_EMAIL_VERIFICATION=0

# ===== Login GitHub (opsional; dibatasi pada anggota GITHUB_ORG) =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Nama organisasi GitHub yang anggotanya diizinkan masuk. Boleh lebih dari satu, pisahkan dengan koma.
GITHUB_ORG=catatan-keuangan

# ===== Keamanan =====
# Origin yang diizinkan mengakses API (CORS), pisahkan dengan koma bila banyak.
# Kosong = pakai APP_URL; bila keduanya kosong fallback ke http://localhost:5173 (dev).
# Produksi: isi dengan alamat frontend, mis. https://finance-catatanku.vercel.app
CORS_ORIGIN=

# Cookie sesi (httpOnly). Default otomatis: secure bila PUBLIC_URL https,
# SameSite none (https) / lax (http). Lintas-domain (frontend & backend beda host)
# WAJIB set COOKIE_SECURE=1 + COOKIE_SAME_SITE=none.
COOKIE_SECURE=
COOKIE_SAME_SITE=
SESSION_COOKIE_NAME=session

# Rate limit umum untuk endpoint data (jumlah permintaan per pengguna per jendela menit).
API_RATE_MAX=300
API_RATE_WINDOW_MINUTES=5

# Rate limit terpusat (Redis/Upstash) — disarankan di produksi agar batas tidak
# hilang saat restart dan tidak terpisah per instance (Vercel serverless).
# Kosong = fallback ke memori (cukup untuk pengembangan lokal).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
